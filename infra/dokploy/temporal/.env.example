# ─────────────────────────────────────────────────────────────
# Temporal env — for the `temporal` Dokploy app. Paste into its Environment tab.
# Locally: cp infra/dokploy/temporal/.env.example infra/dokploy/temporal/.env
# ─────────────────────────────────────────────────────────────

# --- Stack identity ---
# DNS alias other stacks use to reach this server: ${TEMPORAL_ALIAS}:7233
TEMPORAL_ALIAS=temporal

# --- External Postgres (NOT deployed by this stack) ---
# For a Dokploy-managed Postgres, POSTGRES_HOST is that service's container/alias name
# on dokploy-network. The user needs CREATE DATABASE — temporal-schema creates the two
# databases below on first boot.
POSTGRES_HOST=db-host
POSTGRES_PORT=5432
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
TEMPORAL_DBNAME=temporal
TEMPORAL_VISIBILITY_DBNAME=temporal_visibility

# --- Temporal ---
# Upgrading an existing cluster: one minor at a time.
TEMPORAL_VERSION=1.29.7
# admin-tools tags are <server>-tctl-<v>-cli-<v>, not a bare version. Bump with TEMPORAL_VERSION.
TEMPORAL_ADMIN_TOOLS_VERSION=1.29.7-tctl-1.18.4-cli-1.7.2
TEMPORAL_UI_VERSION=2.52.1
# Shard count is FIXED at first boot — changing it later requires a fresh cluster.
TEMPORAL_NUM_HISTORY_SHARDS=512
# MUST equal TEMPORAL_NAMESPACE in the launchstack stack's env.
TEMPORAL_NAMESPACE=default
# Closed-workflow history retention for the namespace. Applied ONLY when
# temporal-bootstrap creates the namespace; on an existing cluster change it with
#   temporal operator namespace update --namespace <ns> --retention <dur>
TEMPORAL_RETENTION=7d
TEMPORAL_LOG_LEVEL=info
# Per-role memory limits. History is the hungry one and the first to raise.
TEMPORAL_HISTORY_MEM=2G
TEMPORAL_MATCHING_MEM=768M
TEMPORAL_FRONTEND_MEM=768M
TEMPORAL_WORKER_MEM=512M

# --- Temporal UI (published, basicauth-gated) ---
# BOTH values below are REQUIRED. temporal-ui carries Traefik labels that publish it at
# TEMPORAL_UI_DOMAIN behind a basicauth middleware. Leaving either blank fails closed
# (broken route, nothing can authenticate) rather than exposing the console — but do not
# lean on that. Set them.
#
# Point this hostname's DNS at the Dokploy host. Do NOT also add it in Dokploy's Domains
# tab — see the compose file for why that silently bypasses the password.
TEMPORAL_UI_DOMAIN=temporal.example.com
#
# Generate the credential:
#   htpasswd -nbB admin 'your-password'
# Then DOUBLE EVERY $ in the resulting bcrypt hash ($ -> $$) before pasting it here, or
# Compose consumes them as variable interpolation and the hash silently becomes garbage
# (symptom: correct password rejected).
TEMPORAL_UI_BASIC_AUTH=
