---
import WaitlistForm from "./WaitlistForm.tsx";
import BriefReel from "./BriefReel.astro";

const headlineLead = "Know what shipped.".split(" ");
const headlineAccent = "In plain English.".split(" ");
const leadOffset = 0;
const accentOffset = headlineLead.length;
---

<section class="hero relative isolate border-b border-border">
  <div class="container mx-auto max-w-[1180px] px-5 md:px-10 hero-grid">
    <div class="hero-copy">
      <span class="hero-eyebrow inline-flex items-center gap-2 px-2.5 py-1 border border-border rounded-full bg-surface font-mono text-[11.5px] tracking-[0.04em] uppercase text-muted">
        <span class="block w-1.5 h-1.5 rounded-full bg-accent"></span>
        Now in private beta · For engineering leaders
      </span>
      <h1 class="hero-headline mt-5 text-[clamp(34px,5.2vw,62px)]">
        {headlineLead.map((word, i) => (
          <span class="hero-word" style={`--i: ${leadOffset + i};`}>{word}</span>
        ))}
        <span class="text-accent">
          {headlineAccent.map((word, i) => (
            <span class="hero-word" style={`--i: ${accentOffset + i};`}>{word}</span>
          ))}
        </span>
      </h1>
      <p class="pt-[clamp(10px,1vw,14px)] text-[clamp(17px,1.4vw,19px)] leading-[1.55] text-muted max-w-[52ch]">
        Save time in standups and meetings — GitBrief connects to your GitHub repos and automatically turns weekly activity into clear delivery briefs. No more hunting down updates or chasing status; get auto-classified, summarized briefs delivered to Slack or email every Monday.
      </p>

      <div id="waitlist" class="mt-8">
        <WaitlistForm client:load />
      </div>

      <div class="mt-3.5 flex flex-wrap gap-4 text-[13px] text-muted">
        <span class="inline-flex items-center gap-1.5"><span class="block w-1 h-1 rounded-full bg-muted-2"></span> Read-only GitHub access</span>
        <span class="inline-flex items-center gap-1.5"><span class="block w-1 h-1 rounded-full bg-muted-2"></span> SOC 2 in progress</span>
        <span class="inline-flex items-center gap-1.5"><span class="block w-1 h-1 rounded-full bg-muted-2"></span> Setup in under 5 minutes</span>
      </div>
    </div>

    <div class="hero-visual">
      <BriefReel />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(64px, 9vw, 120px) 0 clamp(56px, 8vw, 96px);
    overflow-x: clip;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 55% 65% at 50% -10%,
      oklch(70% 0.18 255 / 0.22),
      transparent 65%
    );
    z-index: -1;
    pointer-events: none;
    animation: hero-glow-drift 12s ease-in-out infinite;
    transform-origin: 50% 0%;
  }

  @keyframes hero-glow-drift {
    0%, 100% { transform: scale(1);    opacity: 1;    }
    50%      { transform: scale(1.05); opacity: 0.82; }
  }

  .hero-word {
    display: inline-block;
    margin-right: 0.28em;
    opacity: 0;
    transform: translateY(12px);
    animation: hero-word-in 0.6s ease-out forwards;
    animation-delay: calc(var(--i) * 80ms);
  }

  @keyframes hero-word-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
  }
  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 56px;
    }
  }
</style>
