{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev:dashboard": "dotenv -e .env -- env PORT=3210 node scripts/pg-boss-dashboard.mjs",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest && tsx src/emails/__tests__/render-integration.ts",
    "test:email": "tsx src/emails/__tests__/render-integration.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "drizzle-migrations generate",
    "db:up": "drizzle-migrations up",
    "db:down": "drizzle-migrations down",
    "db:status": "drizzle-migrations status",
    "db:fresh": "drizzle-migrations fresh",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@launchstack/api-interfaces": "workspace:^",
    "@launchstack/core": "workspace:^",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@octokit/app": "^16.1.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.6",
    "@thallesp/nestjs-better-auth": "^2.6.0",
    "better-auth": "^1.6.2",
    "drizzle-orm": "^0.45.2",
    "nestjs-pino": "^4.4.0",
    "openai": "^6.37.0",
    "pg": "^8",
    "pg-boss": "^12",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.3.0",
    "pino-roll": "^3.1.0",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.10.0",
    "rxjs": "^7.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@drepkovsky/drizzle-migrations": "^0.6.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.6",
    "@pg-boss/dashboard": "^1.1.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.17",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.5",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "tsx"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)sx?$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@octokit/app$": "<rootDir>/__mocks__/@octokit/app.ts",
      "^@thallesp/nestjs-better-auth$": "<rootDir>/__mocks__/@thallesp/nestjs-better-auth.ts",
      "^better-auth$": "<rootDir>/__mocks__/better-auth.ts",
      "^better-auth/adapters/drizzle$": "<rootDir>/__mocks__/better-auth/adapters/drizzle.ts",
      "^better-auth/api$": "<rootDir>/__mocks__/better-auth/api.ts",
      "^better-auth/plugins$": "<rootDir>/__mocks__/better-auth/plugins.ts",
      "^openai$": "<rootDir>/__mocks__/openai.ts",
      "^openai/helpers/zod$": "<rootDir>/__mocks__/openai/helpers/zod.ts",
      "^resend$": "<rootDir>/__mocks__/resend.ts",
      "^@react-email/render$": "<rootDir>/__mocks__/@react-email/render.ts",
      "^@react-email/components$": "<rootDir>/__mocks__/@react-email/components.ts",
      "^pg-boss$": "<rootDir>/__mocks__/pg-boss.ts"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
