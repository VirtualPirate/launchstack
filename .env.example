# Used by docker-compose.yaml. Copy to .env and fill in.

# Tag attached to every log line via OTel resource attributes.
DEPLOY_ENV=dev-experimental

# Grafana Cloud OTLP HTTP gateway base URL. Get from:
#   Grafana Cloud -> Connections -> OpenTelemetry -> "Set up via OTLP HTTP".
# Example: https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp

# Pre-encoded HTTP Basic credential: base64(<instance_id>:<api_token>).
# To generate: echo -n "<instance_id>:<api_token>" | base64
# (see Grafana Cloud's OTLP onboarding page for details)
GRAFANA_CLOUD_OTLP_AUTH=glc_eyJvIjoiMjY5NzM1MiIsIm4iOiJncmFmYXBhbmRjb3IiLCJrIjoiTjd0QlhkazM4Szc3WDBYMUlwS0RrdzFFIiwibSI6eyJyIjoicHJvZC1ldS13ZXN0LTIifX0=
