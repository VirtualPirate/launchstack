# ─────────────────────────────────────────────────────────────
# LaunchStack APPLICATION env — for the `launchstack` Dokploy app.
# Under Dokploy: paste this into the app's Environment tab; Dokploy writes it to `.env`
# next to the compose file. Locally: copy it to `.env` IN THIS DIRECTORY — Compose resolves
# `env_file: [.env]` against the compose file's directory, not your shell's cwd.
#   cp infra/dokploy/launchstack/.env.example infra/dokploy/launchstack/.env
#
# This is ONE of TWO env sets. Temporal is a separate Dokploy app with its own env —
# see ../temporal/.env.example. Temporal's Postgres credentials and UI domain live THERE;
# the only thing this side needs is TEMPORAL_ADDRESS, which must match the alias that
# stack publishes.
# ─────────────────────────────────────────────────────────────

# --- Domains ---
# Each needs a DNS A record pointing at the server AND an entry in the Dokploy Domains tab
# (frontend:80, backend:3000).
APP_DOMAIN=app.example.com             # serves the SPA only
API_DOMAIN=api.example.com             # serves the NestJS backend
# API_DOMAIN is baked into the frontend bundle at BUILD time (VITE_API_BASE_URI), so
# changing it requires a rebuild. Verify after deploy with:
#   curl -s --compressed https://app.example.com/assets/index-*.js | grep -o 'https://api[^"]*'
#
# APP_DOMAIN and API_DOMAIN are sibling subdomains of one registrable domain, so browsers
# treat them as SAME-SITE (cross-origin). Session cookies therefore work with Better Auth's
# default SameSite=Lax. Auth CSRF passes because trustedOrigins = [BETTER_AUTH_URL, FRONTEND_URL].

# --- External Postgres (deployed elsewhere) ---
# App database. Temporal's own DB credentials are NOT here — they belong to the temporal
# stack's env, even if it points at the same server.
DATABASE_URL=postgresql://USER:PASSWORD@db-host:5432/launchstack

# --- Auth ---
BETTER_AUTH_SECRET=            # openssl rand -base64 32  (changing it breaks stored encrypted tokens)
BETTER_AUTH_URL=https://api.example.com   # where auth is SERVED (must match API_DOMAIN)
FRONTEND_URL=https://app.example.com      # where users are REDIRECTED back to (must match APP_DOMAIN)

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="LaunchStack <noreply@example.com>"

# --- Google OAuth (optional — omit both to disable) ---
# Authorized redirect URI in the Google Cloud console (served off BETTER_AUTH_URL):
#   https://api.example.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Temporal client (the SERVER is a separate Dokploy app) ---
# Must equal `${TEMPORAL_ALIAS}:7233` from the temporal stack. That alias is host-wide on
# dokploy-network: if two stacks claim it, Docker DNS round-robins between two clusters
# with no error.
TEMPORAL_ADDRESS=temporal:7233
# Must equal TEMPORAL_NAMESPACE in the temporal stack — only its bootstrap job creates it.
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=launchstack
INTERNAL_API_TOKEN=            # openssl rand -hex 32

# --- Worker scaling ---
# Workers are stateless task-queue pollers; raise this to add throughput.
WORKER_REPLICAS=1
# PER REPLICA, not cluster-wide. Effective ceiling = WORKER_REPLICAS x these, against the
# app Postgres pool. Non-integer / zero / negative values fall back to 20.
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=20
TEMPORAL_MAX_CONCURRENT_WORKFLOW_TASKS=20

# --- Logging ---
LOG_LEVEL=info
LOG_FILE_MAX_SIZE=50M
LOG_FILE_KEEP_FILES=7

# --- Observability (Grafana Cloud OTLP) ---
DEPLOY_ENV=production
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_OTLP_AUTH=
