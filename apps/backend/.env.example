DATABASE_URL=postgresql://launchstack:launchstack@localhost:11753/launchstack
BETTER_AUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# Google OAuth (optional - omit to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Temporal (server + UI via `docker compose up -d temporal temporal-ui`)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=launchstack
# Per-worker-process caps (effective ceiling = replicas x these)
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=20
TEMPORAL_MAX_CONCURRENT_WORKFLOW_TASKS=20
# The API registers search attributes and syncs Schedules on boot; the worker
# always opts out. Set false to manage them by hand.
TEMPORAL_MANAGE_SCHEDULES=true

# Internal smoke-test endpoint (POST /api/_internal/queue/noop)
INTERNAL_API_TOKEN=replace-with-openssl-rand-hex-32

# Logging
LOG_LEVEL=info
# Path is resolved relative to apps/backend (the cwd of `pnpm dev:backend`).
# `../../logs/app.log` points at <repo-root>/logs/app.log, the dir that
# docker-compose.yaml bind-mounts into the OTel Collector container.
LOG_FILE_PATH=../../logs/app.log
