{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Backend: Attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "cwd": "${workspaceFolder}/apps/backend",
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Backend: Launch (start:debug)",
      "cwd": "${workspaceFolder}/apps/backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["start:debug"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "envFile": "${workspaceFolder}/apps/backend/.env"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Backend: Jest (current file)",
      "cwd": "${workspaceFolder}/apps/backend",
      "runtimeExecutable": "${workspaceFolder}/apps/backend/node_modules/.bin/jest",
      "args": [
        "--runInBand",
        "--watchAll=false",
        "--testPathPattern",
        "${fileBasenameNoExtension}"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Backend: Jest (all)",
      "cwd": "${workspaceFolder}/apps/backend",
      "runtimeExecutable": "${workspaceFolder}/apps/backend/node_modules/.bin/jest",
      "args": ["--runInBand", "--watchAll=false"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
