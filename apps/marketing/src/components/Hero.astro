---
import WaitlistForm from "./WaitlistForm.tsx";
import BriefDemo from "./BriefDemo.astro";
---

<section class="hero relative isolate border-b border-border">
  <div class="container mx-auto max-w-[1180px] px-5 md:px-10 hero-grid">
    <div class="hero-copy">
      <span class="hero-eyebrow inline-flex items-center gap-2 px-2.5 py-1 border border-border rounded-full bg-surface font-mono text-[11.5px] tracking-[0.04em] uppercase text-muted">
        <span class="block w-1.5 h-1.5 rounded-full bg-accent"></span>
        Now in private beta · For engineering leaders
      </span>
      <h1 class="mt-5 text-[clamp(40px,6.5vw,76px)]">
        Know what shipped. <span class="text-accent">In plain English.</span>
      </h1>
      <p class="mt-5 text-[clamp(17px,1.4vw,19px)] leading-[1.55] text-muted max-w-[52ch]">
        No need to ask developers what they have been working on. GitBrief connects to your GitHub
        repos and turns weekly activity into clear delivery briefs — auto-classified, summarized,
        and delivered to Slack or email every Monday.
      </p>

      <div id="waitlist" class="mt-8">
        <WaitlistForm client:load />
      </div>

      <div class="mt-3.5 flex flex-wrap gap-4 text-[13px] text-muted">
        <span class="inline-flex items-center gap-1.5"><span class="block w-1 h-1 rounded-full bg-muted-2"></span> Read-only GitHub access</span>
        <span class="inline-flex items-center gap-1.5"><span class="block w-1 h-1 rounded-full bg-muted-2"></span> SOC 2 in progress</span>
        <span class="inline-flex items-center gap-1.5"><span class="block w-1 h-1 rounded-full bg-muted-2"></span> Setup in under 5 minutes</span>
      </div>
    </div>

    <div class="hero-visual">
      <BriefDemo />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(64px, 9vw, 120px) 0 clamp(56px, 8vw, 96px);
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 55% 65% at 50% -10%,
      oklch(70% 0.18 255 / 0.22),
      transparent 65%
    );
    z-index: -1;
    pointer-events: none;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
  }
  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 56px;
    }
  }
</style>
