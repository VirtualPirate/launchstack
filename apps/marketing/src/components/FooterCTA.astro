---
import WaitlistForm from "./WaitlistForm.tsx";
---

<section class="footer-cta py-[clamp(80px,10vw,130px)] text-center border-b border-border">
  <div class="container mx-auto max-w-[1180px] px-5 md:px-10">
    <h2 class="text-[clamp(32px,4.5vw,52px)]">Stop asking. Start reading.</h2>
    <p class="sub mt-5 text-base text-muted max-w-[50ch] mx-auto">
      Join the waitlist and we'll send you an invite the week we open up your team size.
    </p>
    <div class="mt-7 flex justify-center">
      <WaitlistForm client:visible buttonLabel="Request access" />
    </div>
    <div class="mt-3.5 flex justify-center flex-wrap gap-4 text-[13px] text-muted">
      <span class="inline-flex items-center gap-1.5"><span class="block w-1 h-1 rounded-full bg-muted-2"></span> No credit card</span>
      <span class="inline-flex items-center gap-1.5"><span class="block w-1 h-1 rounded-full bg-muted-2"></span> Unsubscribe any time</span>
    </div>
  </div>
</section>
