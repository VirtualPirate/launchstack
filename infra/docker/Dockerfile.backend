# syntax=docker/dockerfile:1
# NestJS API + Temporal worker share this image; compose overrides the command.
# Build context = repo root:  docker build -f infra/docker/Dockerfile.backend .

# ---- builder ----
FROM node:22-bookworm-slim AS builder
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate
WORKDIR /repo

# manifests first so `pnpm install` layer caches across source changes.
# all workspace package.json files are required for --frozen-lockfile.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/api-interfaces/package.json packages/api-interfaces/
COPY packages/core/package.json packages/core/
COPY apps/backend/package.json apps/backend/
COPY apps/frontend/package.json apps/frontend/
RUN pnpm install --frozen-lockfile

# sources needed to build the backend
COPY packages ./packages
COPY apps/backend ./apps/backend

# shared packages must be built before the app consumes them
RUN pnpm build:packages
# nest build -> flat dist/main.js + dist/worker.js (rootDir=./src, see backend AGENTS.md)
RUN pnpm --filter backend build
# self-contained deploy dir: real node_modules (workspace deps resolved, no store symlinks) + dist.
# --legacy: pnpm 10 deploy otherwise requires inject-workspace-packages=true.
RUN pnpm --filter backend --prod --legacy deploy /prod

# ---- migrate ----
# One-shot Kysely migrator. Reuses the builder (full deps incl. the kysely-ctl
# devDep, which the --prod runtime image lacks) plus apps/backend/migrations/*.ts and
# kysely.config.ts. Reads DATABASE_URL from the container env.
FROM builder AS migrate
CMD ["pnpm", "--filter", "backend", "db:up"]

# ---- runtime ----
FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV PORT=3000
WORKDIR /app
COPY --from=builder /prod ./
EXPOSE 3000
# default = API; the worker service overrides this with dist/worker.js
CMD ["node", "dist/main.js"]
